# 1. Navigate to your project directory
cd /home/project/final_project

# 2. Initialize Git if not already initialized
git init

# 3. Stage all your project files (including EmotionDetection folder)
git add .

# 4. Commit your files
git commit -m "Submit final project code and package"

# 5. Set the default branch to main
git branch -M main

# 6. Link to your forked repository
git remote add origin https://github.com/paragbombatkar/oaqjp-final-project-emb-ai.git

# 7. Push the code to GitHub
git push -u origin main
